{
  "headers": [
    {
      "source": "/circuit/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!circuit/).*)",
      "destination": "/index.html"
    }
  ]
}